// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTypeEnum {
  internal
  clinic
  supplier
}

enum UserStatusEnum {
  active
  inactive
  suspended
  pending
}

enum AccountTypeEnum {
  internal
  clinic
  supplier
}

model User {
  user_id       BigInt  @id @default(autoincrement())
  uuid          String  @unique @default(uuid())
  username      String  @unique @db.VarChar(100)
  email         String  @unique @db.VarChar(255)
  password_hash String  @db.VarChar(255)
  first_name    String  @db.VarChar(100)
  last_name     String  @db.VarChar(100)
  phone         String? @db.VarChar(50)

  account_type AccountTypeEnum @default(internal)
  user_type    UserTypeEnum    @default(internal)
  position     String?         @db.VarChar(100)

  status         UserStatusEnum @default(pending)
  email_verified Boolean        @default(false)
  phone_verified Boolean        @default(false)
  notify_user    Boolean        @default(true)

  last_login_at         DateTime?
  last_login_ip         String?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  password_changed_at   DateTime?
  must_change_password  Boolean   @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  created_by BigInt?
  updated_by BigInt?
  deleted_by BigInt?

  createdBy User? @relation("UserCreatedBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("UserUpdatedBy", fields: [updated_by], references: [user_id])
  deletedBy User? @relation("UserDeletedBy", fields: [deleted_by], references: [user_id])

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")
  deletedUsers User[] @relation("UserDeletedBy")

  roles        UserRole[]  @relation("UserRolesUser")
  groups       UserGroup[] @relation("UserGroupsUser")
  rolesCreated Role[]      @relation("RolesCreatedBy")
  rolesUpdated Role[]      @relation("RolesUpdatedBy")

  userRolesAssigned  UserRole[]     @relation("UserRolesAssignedBy")
  userGroupsAssigned UserGroup[]    @relation("UserGroupsAssignedBy")
  auditLogs          AuditLog[]
  loginHistories     LoginHistory[]
  errorLogs          ErrorLog[]
  mfaMethods         UserMfa[]
  mfaLogs            UserMfaLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([status])
  @@index([account_type])
  @@index([created_at(sort: Desc)])
  @@index([last_login_at(sort: Desc)])
  @@map("users")
}

model Role {
  role_id        Int     @id @default(autoincrement())
  role_name      String  @unique @db.VarChar(100)
  display_name   String  @db.VarChar(150)
  description    String?
  is_system_role Boolean @default(false)
  is_active      Boolean @default(true)
  permissions    Json?
  priority       Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by BigInt?
  updated_by BigInt?

  createdBy User? @relation("RolesCreatedBy", fields: [created_by], references: [user_id])
  updatedBy User? @relation("RolesUpdatedBy", fields: [updated_by], references: [user_id])

  users UserRole[]

  @@index([role_name])
  @@index([is_active])
  @@map("roles")
}

model UserRole {
  user_role_id BigInt    @id @default(autoincrement())
  user_id      BigInt
  role_id      Int
  assigned_at  DateTime  @default(now())
  assigned_by  BigInt?
  expires_at   DateTime?
  is_active    Boolean   @default(true)

  user       User  @relation("UserRolesUser", fields: [user_id], references: [user_id], onDelete: Cascade)
  role       Role  @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  assignedBy User? @relation("UserRolesAssignedBy", fields: [assigned_by], references: [user_id], onDelete: SetNull)

  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

model Position {
  position_id   Int     @id @default(autoincrement())
  position_name String  @unique @db.VarChar(100)
  display_name  String  @db.VarChar(150)
  description   String?
  department    String? @db.VarChar(100)
  is_active     Boolean @default(true)
  sort_order    Int     @default(0)

  @@map("positions")
}

model InternalGroup {
  group_id     Int      @id @default(autoincrement())
  group_name   String   @unique @db.VarChar(100)
  display_name String   @db.VarChar(150)
  description  String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  users UserGroup[]

  @@map("internal_groups")
}

model UserGroup {
  user_group_id BigInt   @id @default(autoincrement())
  user_id       BigInt
  group_id      Int
  assigned_at   DateTime @default(now())
  assigned_by   BigInt?

  user       User          @relation("UserGroupsUser", fields: [user_id], references: [user_id], onDelete: Cascade)
  group      InternalGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  assignedBy User?         @relation("UserGroupsAssignedBy", fields: [assigned_by], references: [user_id], onDelete: SetNull)

  @@unique([user_id, group_id])
  @@index([user_id])
  @@index([group_id])
  @@map("user_groups")
}

enum AuditActionEnum {
  create
  read
  update
  delete
  login
  logout
  approve
  reject
  export
}

model AuditLog {
  audit_id BigInt @id @default(autoincrement())

  // Who
  user_id   BigInt?
  username  String? @db.VarChar(100)
  user_type String? @db.VarChar(50)

  // What
  action      AuditActionEnum
  entity_type String          @db.VarChar(100)
  entity_id   String?         @db.VarChar(100)
  entity_name String?         @db.VarChar(255)

  // Details
  description String?
  old_values  Json?
  new_values  Json?
  changes     Json?

  // Where
  ip_address String?
  user_agent String?

  // When
  created_at DateTime @default(now())

  // Context
  request_id String? @db.Uuid
  session_id String? @db.Uuid

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
  @@index([entity_type, entity_id, created_at(sort: Desc)])
  @@index([action, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("audit_logs")
}

model LoginHistory {
  login_id BigInt @id @default(autoincrement())
  user_id  BigInt

  // Login Details
  login_type     String? @db.VarChar(50)
  status         String  @db.VarChar(50)
  failure_reason String? @db.VarChar(255)

  // Location & Device
  ip_address       String?
  user_agent       String?
  device_type      String? @db.VarChar(50)
  browser          String? @db.VarChar(100)
  os               String? @db.VarChar(100)
  location_country String? @db.VarChar(100)
  location_city    String? @db.VarChar(100)

  // Timing
  attempted_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, attempted_at(sort: Desc)])
  @@index([status, attempted_at(sort: Desc)])
  @@map("login_history")
}

model ErrorLog {
  error_id BigInt @id @default(autoincrement())

  // Error Details
  error_code    String? @db.VarChar(50)
  error_message String
  error_type    String? @db.VarChar(100)
  severity      String? @db.VarChar(50)

  // Stack Trace
  stack_trace String?

  // Context
  user_id        BigInt?
  session_id     String? @db.Uuid
  request_id     String? @db.Uuid
  request_url    String? @db.VarChar(1000)
  request_method String? @db.VarChar(10)

  // Environment
  ip_address String?
  user_agent String?

  // Timing
  occurred_at DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([severity, occurred_at(sort: Desc)])
  @@index([user_id, occurred_at(sort: Desc)])
  @@index([occurred_at(sort: Desc)])
  @@map("error_logs")
}

enum MfaMethodEnum {
  email_otp
  sms_otp
  authenticator_app
  backup_codes
}

enum MfaStatusEnum {
  pending
  verified
  expired
  failed
}

model UserMfa {
  mfa_id     BigInt        @id @default(autoincrement())
  user_id    BigInt
  mfa_method MfaMethodEnum
  is_enabled Boolean       @default(true)

  secret_key   String? @db.VarChar(255)
  backup_codes Json?
  phone_number String? @db.VarChar(50)

  created_at DateTime @default(now())
  updated_at DateTime

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_mfa")
}

model UserMfaLog {
  log_id     BigInt        @id @default(autoincrement())
  user_id    BigInt
  mfa_method MfaMethodEnum
  otp_code   String?       @db.VarChar(10)
  status     MfaStatusEnum

  ip_address String?
  user_agent String?

  attempted_at DateTime  @default(now())
  expires_at   DateTime?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, attempted_at(sort: Desc)])
  @@index([status, attempted_at(sort: Desc)])
  @@map("user_mfa_logs")
}

model PasswordResetToken {
  token_id   BigInt    @id @default(autoincrement())
  user_id    BigInt

  token      String    @unique @db.VarChar(500)

  created_at DateTime  @default(now())
  expires_at DateTime
  used_at    DateTime?

  ip_address String?

  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("password_reset_tokens")
}

